{
  "name": "dsh-cortex-memory",
  "version": "0.4.11",
  "description": "Local-first layered memory engine for DeepSeek Harness",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "bin": {
    "dsh-cortex": "./bin/cortex.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./api/client": "./src/api/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "scripts": {
    "test:unit": "node --test test/unit/",
    "bench": "node bench/run.js",
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.4.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.4.0",
      "node": ">=24",
      "profiles": [
        "desktop",
        "web"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "temporal-graph",
    "spaced-repetition",
    "self-evolving",
    "sqlite"
  ],
  "license": "MIT",
  "author": {
    "name": "Lh1314-China",
    "url": "https://github.com/Lh1314-China"
  },
  "homepage": "https://github.com/Lh1314-China/dsh-cortex-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lh1314-China/dsh-cortex-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Lh1314-China/dsh-cortex-memory/issues"
  }
}
